# Quant Platform settings (QP_ prefix)
QP_DB_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/quant_platform
QP_LOG_LEVEL=INFO
QP_LOG_FORMAT=json
QP_REAL_TRADING=false
QP_RUN_MODE=local
QP_API_HOST=0.0.0.0
QP_API_PORT=8000

# Kill switch
QP_KILL_SWITCH_PORT=8001
QP_KILL_SWITCH_HEARTBEAT_INTERVAL=5
QP_KILL_SWITCH_HEARTBEAT_TIMEOUT=15

# LLM
QP_LLM_PROVIDER=claude
QP_LLM_MODEL=claude-sonnet-4-6
QP_LLM_API_KEY=
QP_OLLAMA_BASE_URL=http://localhost:11434

# Telegram notifications (optional)
QP_TELEGRAM_BOT_TOKEN=
QP_TELEGRAM_CHAT_ID=

# Agent System (set when running agent orchestrator)
# ANTHROPIC_API_KEY=your-key-here
