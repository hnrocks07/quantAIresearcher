# Quant Platform settings (QP_ prefix)
QP_DB_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/quant_platform
QP_LOG_LEVEL=INFO
QP_LOG_FORMAT=json
QP_REAL_TRADING=false
QP_RUN_MODE=local
QP_API_HOST=0.0.0.0
QP_API_PORT=8000

# Kill switch
QP_KILL_SWITCH_PORT=8001
QP_KILL_SWITCH_HEARTBEAT_INTERVAL=5
QP_KILL_SWITCH_HEARTBEAT_TIMEOUT=15

# LLM
QP_LLM_PROVIDER=claude
QP_LLM_MODEL=claude-sonnet-4-6
QP_LLM_API_KEY=
QP_OLLAMA_BASE_URL=http://localhost:11434

# Broker (Angel One)
QP_BROKER_ADAPTER=paper
QP_ANGEL_API_KEY=
QP_ANGEL_CLIENT_ID=
QP_ANGEL_PIN=
QP_ANGEL_TOTP_SECRET=

# Data provider: yfinance, nse_bhav, jugaad_nse, crypto, indstocks, nsedata
QP_DATA_PROVIDER=yfinance
QP_RESEARCH_SOURCE_MODE=both

# TradingView (for premium script discovery)
QP_TRADINGVIEW_USERNAME=
QP_TRADINGVIEW_PASSWORD=

# INDstocks API (free account at indstocks.com, for 5m/15m intraday)
QP_INDSTOCKS_TOKEN=

# Daily auto-update (SERVER mode only, IST time)
QP_AUTO_UPDATE_ENABLED=true
QP_AUTO_UPDATE_TIME=15:45

# Trading parameters
QP_PAPER_TRADING_DAYS_REQUIRED=14
QP_MAX_POSITIONS=20
QP_DAILY_LOSS_CAP_PCT=0.05
QP_MAX_STRATEGY_DRAWDOWN=0.05
QP_PROMOTION_WIN_RATE=0.80
QP_PROMOTION_MIN_TRADES=20

# Growth target: 1L to 1Cr in 250 trading days
QP_GROWTH_TARGET_ENABLED=true
QP_GROWTH_TARGET_INITIAL=100000
QP_GROWTH_TARGET_FINAL=10000000
QP_GROWTH_TARGET_TRADING_DAYS=250
QP_GROWTH_TARGET_WIN_RATE=0.60
QP_GROWTH_TARGET_WIN_DAY_PCT=0.045
QP_GROWTH_TARGET_LOSS_DAY_PCT=0.02

# Telegram notifications (optional)
QP_TELEGRAM_BOT_TOKEN=
QP_TELEGRAM_CHAT_ID=

# Agent System (set when running agent orchestrator)
# ANTHROPIC_API_KEY=your-key-here
